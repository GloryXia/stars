# Local development only. Keep these services bound to loopback.
DATABASE_URL=postgres://stars:stars_local_only@127.0.0.1:5432/stars
POSTGRES_PASSWORD=stars_local_only
REDIS_URL=redis://127.0.0.1:6379
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# The local-only development session is opt-in; production must use OIDC.
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=local-development-only-token-change-me
